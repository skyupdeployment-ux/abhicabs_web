# ── Environment Variables ─────────────────────────────────────────────────────
# Copy these into your .env or .env.local file

# Backend API base URL
VITE_API_BASE_URL=https://api.abhicabs24x7.com/api/v1

# Cloudinary — for image uploads inside blog posts
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# GitHub — for publishing blogs (commits to blogs.js)
VITE_GH_TOKEN=ghp_your_github_personal_access_token
# VITE_GH_REPO=owner/repo
